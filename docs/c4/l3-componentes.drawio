<mxfile host="app.diagrams.net">
  <diagram name="C4 L3 - Componentes Backend" id="c4-l3-backend">
    <mxGraphModel dx="1800" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1290" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="titulo" value="&lt;b&gt;MediTriage — Diagrama C4 Nivel 3 (Componentes) · Backend&lt;/b&gt;" style="text;html=1;fontSize=18;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="30" as="geometry" /></mxCell>
        <mxCell id="b_backend" value="&lt;b&gt;Backend&lt;/b&gt; [Contenedor: Monolito Modular — FastAPI, Python 3.11+, Uvicorn] · backend/app/" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=2;dashed=1;dashPattern=6 4;strokeWidth=2;fillColor=none;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontSize=13;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="1360" height="860" as="geometry" /></mxCell>
        <mxCell id="g_api" value="Capa API · routers FastAPI /api/v1 (validación con Pydantic, app/schemas/)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=3;dashed=1;fillColor=none;strokeColor=#5D82A8;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fontStyle=2;container=0;" vertex="1" parent="1"><mxGeometry x="70" y="350" width="1280" height="165" as="geometry" /></mxCell>
        <mxCell id="g_ia" value="Motor de IA embebido · app/ai/" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=3;dashed=1;fillColor=none;strokeColor=#5D82A8;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fontStyle=2;container=0;" vertex="1" parent="1"><mxGeometry x="350" y="550" width="660" height="272" as="geometry" /></mxCell>
        <mxCell id="frontend" value="&lt;b&gt;Frontend&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contenedor: Next.js, React/TypeScript]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Un solo portal con 4 vistas según rol. WebSockets/SSE." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="550" y="55" width="420" height="85" as="geometry" /></mxCell>
        <mxCell id="postgres" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contenedor: pgcrypto + Row-Level Security]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Pacientes, episodios, clasificación IA, decisiones y Audit Log inmutable." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="1080" width="240" height="125" as="geometry" /></mxCell>
        <mxCell id="redis" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contenedor: Pub/Sub + sesiones]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Canal triage:eventos para actualizaciones en vivo." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="1080" width="240" height="125" as="geometry" /></mxCell>
        <mxCell id="logs" value="&lt;b&gt;Agregación de logs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Sistema externo: Grafana Loki + Alloy + Grafana]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Junta los logs JSON de todas las réplicas. Sin PII (ADR OBS-001)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#8C9EB1;strokeColor=#6B7D90;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1460" y="215" width="270" height="115" as="geometry" /></mxCell>
        <mxCell id="anthropic" value="&lt;b&gt;API Anthropic (Claude Haiku 5.5)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Sistema externo · modelo claude-haiku-5-5 (ANTHROPIC_MODEL)]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Recibe la ficha sanitizada (sin PII); devuelve nivel ESI sugerido + justificación." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#8C9EB1;strokeColor=#6B7D90;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1460" y="560" width="270" height="120" as="geometry" /></mxCell>
        <mxCell id="nota" value="&lt;b&gt;Fuera del alcance de esta entrega&lt;/b&gt;&lt;br&gt;&lt;br&gt;Aparecen en el C4 L2, pero el backend no se conecta a ellos:&lt;br&gt;• Sistema Hospitalario (HIS/EMR): sin integración.&lt;br&gt;• Proveedor de Autenticación (SSO/Keycloak): el login es JWT propio (bcrypt + HS256) contra la tabla usuario_staff." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=note;size=14;dashed=1;fillColor=#FFF8DC;strokeColor=#B59F3B;align=left;spacingLeft=8;spacingRight=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1460" y="770" width="270" height="190" as="geometry" /></mxCell>
        <mxCell id="mw" value="&lt;b&gt;Middleware HTTP y seguridad&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: Starlette middleware · main.py, core/seguridad_http.py, core/rate_limit.py]&lt;/font&gt;&lt;br&gt;&lt;br&gt;request_id por petición, CORS restringido, headers CSP/HSTS, límite de peticiones (429) y errores problem+json." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="80" y="230" width="840" height="85" as="geometry" /></mxCell>
        <mxCell id="obs" value="&lt;b&gt;Observabilidad&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: OpenTelemetry · core/telemetry.py, core/logging_config.py]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Logs JSON a stdout con PII enmascarada y trace_id; métricas en :9464." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="1010" y="230" width="330" height="85" as="geometry" /></mxCell>
        <mxCell id="ep_auth" value="&lt;b&gt;API Auth&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: router FastAPI · endpoints/auth.py]&lt;/font&gt;&lt;br&gt;&lt;br&gt;/auth/login, /me, /logout. Emite el JWT en cookie httpOnly." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="87" y="380" width="165" height="122" as="geometry" /></mxCell>
        <mxCell id="ep_pac" value="&lt;b&gt;API Pacientes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: router FastAPI · endpoints/patients.py]&lt;/font&gt;&lt;br&gt;&lt;br&gt;/patients. Alta y búsqueda por RUT (hash HMAC, datos cifrados)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="267" y="380" width="165" height="122" as="geometry" /></mxCell>
        <mxCell id="ep_tri" value="&lt;b&gt;API Triage&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: router FastAPI · endpoints/triage.py]&lt;/font&gt;&lt;br&gt;&lt;br&gt;/triage/formulario, /{id}/evaluate, /{id}/decision. Orquesta el caso de uso." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="447" y="380" width="165" height="122" as="geometry" /></mxCell>
        <mxCell id="ep_cola" value="&lt;b&gt;API Cola priorizada&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: router FastAPI · endpoints/triage.py]&lt;/font&gt;&lt;br&gt;&lt;br&gt;/triage/cola y /cola/resumen. Ordena por ESI y tiempo de espera." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="627" y="380" width="165" height="122" as="geometry" /></mxCell>
        <mxCell id="ep_sala" value="&lt;b&gt;API Sala de espera&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: router FastAPI · endpoints/sala_espera.py]&lt;/font&gt;&lt;br&gt;&lt;br&gt;/sala-espera. Pública, turnos anonimizados, límite por IP." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="807" y="380" width="165" height="122" as="geometry" /></mxCell>
        <mxCell id="ep_aud" value="&lt;b&gt;API Auditoría&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: router FastAPI · endpoints/audit_logs.py]&lt;/font&gt;&lt;br&gt;&lt;br&gt;/audit-logs y /verificacion. Solo rol auditor, lectura." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="987" y="380" width="165" height="122" as="geometry" /></mxCell>
        <mxCell id="ep_ws" value="&lt;b&gt;WebSocket Tablero&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: router FastAPI · endpoints/ws.py]&lt;/font&gt;&lt;br&gt;&lt;br&gt;/ws/tablero. Valida el token y reenvía eventos en vivo." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="1167" y="380" width="165" height="122" as="geometry" /></mxCell>
        <mxCell id="auth" value="&lt;b&gt;Autenticación y roles&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: JWT HS256 + bcrypt · core/auth.py, core/security.py]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Lee el token (cookie httpOnly o Bearer). requiere_rol(): 401/403 para enfermero, médico y auditor." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="80" y="560" width="210" height="150" as="geometry" /></mxCell>
        <mxCell id="orq" value="&lt;b&gt;Orquestador IA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: LangChain (LCEL) + SDK Anthropic · ai/engine.py]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Arma la ficha anonimizada, llama a Claude con límite de 1500 ms y valida la salida con Pydantic (ai/contrato.py)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="362" y="580" width="636" height="80" as="geometry" /></mxCell>
        <mxCell id="ia_san" value="&lt;b&gt;① Sanitizador PII&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente · core/sanitizer.py, ai/contrato.py]&lt;/font&gt;&lt;br&gt;&lt;br&gt;EntradaIA (extra=forbid). Enmascara RUT, correo y teléfono." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="362" y="710" width="150" height="100" as="geometry" /></mxCell>
        <mxCell id="ia_inj" value="&lt;b&gt;② Anti prompt-injection&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente · ai/anti_injection.py]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Bloquea órdenes al modelo y pedidos de ESI en el motivo de consulta." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="524" y="710" width="150" height="100" as="geometry" /></mxCell>
        <mxCell id="ia_gr" value="&lt;b&gt;③ Guardrails G1–G5&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente · ai/guardrails.py]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Revisa la respuesta: rango ESI, signos críticos, sin variables socioeconómicas." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="686" y="710" width="150" height="100" as="geometry" /></mxCell>
        <mxCell id="ia_fb" value="&lt;b&gt;④ Respaldo por reglas&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente · ai/reglas.py]&lt;/font&gt;&lt;br&gt;&lt;br&gt;fallback-rule-engine si Claude falla, tarda o rompe un guardrail." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="848" y="710" width="150" height="100" as="geometry" /></mxCell>
        <mxCell id="pub" value="&lt;b&gt;Publicador tiempo real&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: redis-py Pub/Sub · core/realtime.py]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Publica eventos sin PII en triage:eventos. Si Redis falla, solo avisa en el log." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="1060" y="690" width="280" height="100" as="geometry" /></mxCell>
        <mxCell id="datos" value="&lt;b&gt;Acceso a datos con RLS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: psycopg 3 · db.py, core/canary.py, core/rut_hash.py]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Abre la conexión y fija app.rol y app.usuario_id por transacción (contextos enfermero, médico, auditor, autenticacion y sala_espera). Verifica la clave pgcrypto al arrancar y calcula el hash HMAC del RUT." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="80" y="860" width="560" height="125" as="geometry" /></mxCell>
        <mxCell id="audit" value="&lt;b&gt;Auditoría inmutable&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: módulo Python · audit.py]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Inserta en registro_auditoria en la misma transacción del hecho clínico; el hash encadenado lo pone un trigger (WORM)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;fontSize=10;spacing=4;" vertex="1" parent="1"><mxGeometry x="760" y="860" width="250" height="125" as="geometry" /></mxCell>
        <mxCell id="e1" value="llamadas API [HTTPS/JSON] y WebSocket [WSS]" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.8095;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="frontend" target="mw"><mxGeometry x="-0.5600" relative="1" as="geometry"><mxPoint x="0.0" y="0.2" as="offset" /></mxGeometry></mxCell>
        <mxCell id="e2" value="enruta /api/v1/*" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.8095;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5391;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="mw" target="g_api"><mxGeometry x="-0.0200" relative="1" as="geometry"><mxPoint x="60.0" y="-0.1" as="offset" /></mxGeometry></mxCell>
        <mxCell id="e3" value="telemetría&lt;br&gt;por petición" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1.0000;exitY=0.4941;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.4941;entryDx=0;entryDy=0;" edge="1" parent="1" source="mw" target="obs"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="0.0" y="-20.0" as="offset" /></mxGeometry></mxCell>
        <mxCell id="e4" value="logs JSON (stdout)&lt;br&gt;vía Alloy [HTTP]" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1.0000;exitY=0.4941;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.4957;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="obs" target="logs"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="0.0" y="28.0" as="offset" /></mxGeometry></mxCell>
        <mxCell id="e5" value="valida JWT y rol" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.0898;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_api" target="auth"><mxGeometry x="-0.0200" relative="1" as="geometry"><mxPoint x="0.0" y="-0.0" as="offset" /></mxGeometry></mxCell>
        <mxCell id="e6" value="consultas SQL (get_conn)" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.1953;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.4286;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_api" target="datos"><mxGeometry x="-0.8800" relative="1" as="geometry"><mxPoint x="2.0" y="1.3" as="offset" /></mxGeometry></mxCell>
        <mxCell id="e7" value="pide ESI sugerido" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5636;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.2799;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="ep_tri" target="orq"><mxGeometry x="0.6600" relative="1" as="geometry"><mxPoint x="60.0" y="0.3" as="offset" /></mxGeometry></mxCell>
        <mxCell id="e8" value="registra evento&lt;br&gt;(misma transacción)" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.8667;exitY=1.0000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.4960;entryDx=0;entryDy=0;" edge="1" parent="1" source="ep_tri" target="audit"><mxGeometry x="0.7588" relative="1" as="geometry"><mxPoint x="0.0" y="0.3" as="offset" /><Array as="points"><mxPoint x="590" y="530" /><mxPoint x="1035" y="530" /><mxPoint x="1035" y="922" /></Array></mxGeometry></mxCell>
        <mxCell id="e9" value="publica evento&lt;br&gt;triage.evaluacion.confirmada" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.8667;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="ep_tri" target="pub"><mxGeometry x="0.6792" relative="1" as="geometry"><mxPoint x="70.0" y="0.0" as="offset" /><Array as="points"><mxPoint x="590" y="530" /><mxPoint x="1200" y="530" /></Array></mxGeometry></mxCell>
