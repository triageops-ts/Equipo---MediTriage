# Copia este archivo a .env y completa los valores. El archivo .env NO se sube al repo.
# Nunca escribas claves reales aquí.

# Usuario de la APP: meditriage_app (el RLS se aplica). Nunca el usuario dueño.
DATABASE_URL=postgresql://meditriage_app:CLAVE_APP@localhost:5432/meditriage_db
APP_ENCRYPTION_KEY=REEMPLAZAR_POR_UNA_CLAVE_ALEATORIA
# Clave aparte para el hash del RUT (rut_hash). Distinta de APP_ENCRYPTION_KEY.
APP_RUT_HASH_KEY=REEMPLAZAR_POR_OTRA_CLAVE_ALEATORIA
REDIS_URL=redis://localhost:6379/0

# IA (S09-4). Sin ANTHROPIC_API_KEY el motor no falla: usa el árbol de reglas de respaldo.
ANTHROPIC_API_KEY=
# Opcional: modelo de Claude. Si se omite, se usa el de por defecto del motor.
ANTHROPIC_MODEL=claude-haiku-5-5

LOG_LEVEL=INFO

# Solo para migraciones (alembic). La app usa DATABASE_URL con el usuario meditriage_app.
MIGRATION_DATABASE_URL=postgresql://USUARIO_DUENO:CLAVE@localhost:5432/meditriage_db