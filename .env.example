# Copia este archivo a .env y completa los valores. El archivo .env NO se sube al repo.
# Nunca escribas claves reales aquí.

# Usuario de la APP (meditriage_app): el RLS se aplica. Es el que usa la API.
DATABASE_URL=postgresql://meditriage_app:CLAVE_APP@HOST_DE_NEON/neondb?sslmode=require
APP_ENCRYPTION_KEY=REEMPLAZAR_POR_UNA_CLAVE_ALEATORIA
# Clave aparte para el hash del RUT (rut_hash). Distinta de APP_ENCRYPTION_KEY.
APP_RUT_HASH_KEY=REEMPLAZAR_POR_OTRA_CLAVE_ALEATORIA
REDIS_URL=redis://localhost:6379/0

# IA (S09-4). Sin ANTHROPIC_API_KEY el motor no falla: usa el árbol de reglas de respaldo.
ANTHROPIC_API_KEY=
# Opcional: modelo de Claude. Si se omite, se usa el de por defecto del motor.
ANTHROPIC_MODEL=claude-haiku-5-5

LOG_LEVEL=INFO

# S11-1. development activa la recarga automática (python app/main.py) y omite el header HSTS.
# En el contenedor/k8s debe ser production (ver k8s/configmap.yaml).
ENVIRONMENT=development
# Orígenes que pueden llamar a la API desde el navegador (separados por coma). Nunca "*".
CORS_ORIGINS=http://localhost:3000
# Límite de peticiones: "<cantidad>/<second|minute|hour|day>". RATE_LIMIT_ENABLED=false lo apaga.
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_TRIAGE=120/minute
# Proxies de confianza delante de la API (rewrite de Next, Ingress). 0 = ignora X-Forwarded-For.
TRUSTED_PROXY_HOPS=0

# Usuario dueño: solo para migraciones (alembic upgrade head). Nunca para la API.
MIGRATION_DATABASE_URL=postgresql://neondb_owner:CLAVE_DUENO@HOST_DE_NEON/neondb?sslmode=require
